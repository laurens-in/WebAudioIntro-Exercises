                    "code": "function msg_int(numNotes) {\n  let notes = [0];\n  let lastStep = 2;\n\n  for (var i = 1; i < numNotes; i++) {\n    let step;\n    if (lastStep === 1) {\n      step = 2;\n    } else {\n      step = Math.random() < 0.5 ? 1 : 2;\n    }\n    notes.push(notes[notes.length - 1] + step);\n    lastStep = step;\n  }\n\n  outlet(0, notes);\n}",
